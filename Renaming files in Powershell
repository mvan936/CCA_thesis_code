# Root folder containing the 35 rhodolith subfolders
$root = "C:\Users\ADMIN\Dropbox\cca-seedbanks\SEM\Experiment 4\Experiment_v3"

Get-ChildItem -Path $root -Directory | ForEach-Object {

    $folder     = $_.FullName
    $folderName = $_.Name

    # Rhodolith ID from folder name (pad numeric names to 2 digits)
    if ($folderName -match '^\d+$') {
        $rhID = "Rh{0:D2}" -f [int]$folderName
    } else {
        $rhID = "Rh_$folderName"
    }

    Write-Host "`nProcessing folder: $folder ($rhID)"

    $surfCount = 0
    $xsecCount = 0

    # Start from TIF files only; HDRs will be matched afterwards
    $tifs = Get-ChildItem $folder -File -Filter *.tif

    foreach ($tif in $tifs) {

        $oldBase = [System.IO.Path]::GetFileNameWithoutExtension($tif.Name)
        $lower   = $oldBase.ToLower()

        # Detect ANY crosssection typo (covers everything you showed)
        $isXsec =
            $lower -match "cross"  -or    # crosssection, cross_section
            $lower -match "cros"   -or    # crossection
            $lower -match "croas"  -or    # croassection
            $lower -match "croass" -or    # croasssection
            $lower -match "xsec"   -or    # xsec
            $lower -match "border"        # cross section border

        # Detect proper surfaces
        $isSurfExplicit =
            $lower -match "surface" -or
            $lower -match "biofilm"

        # Classification
        if ($isXsec) {
            $xsecCount++
            $view  = "Xsec"
            $point = "{0:D2}" -f $xsecCount
        }
        else {
            # All non-Xsec become Surf (including numbers-only)
            $surfCount++
            $view  = "Surf"
            $point = "{0:D2}" -f $surfCount
        }

        # Build new base name
        $newBase = "${rhID}_${view}_P${point}"

        # ----- Rename TIF -----
        $newTifName = "$newBase.tif"
        Rename-Item -LiteralPath $tif.FullName -NewName $newTifName
        Write-Host "TIF  $($tif.Name)  ->  $newTifName"

        # ----- Find matching HDR -----
        # HDR files usually contain oldBase or oldBase + "-tif"
        $hdr = Get-ChildItem $folder -File -Filter *.hdr |
               Where-Object { $_.BaseName -like "$oldBase*" } |
               Select-Object -First 1

        if ($hdr) {
            $newHdrName = "$newBase.hdr"
            Rename-Item -LiteralPath $hdr.FullName -NewName $newHdrName
            Write-Host "HDR  $($hdr.Name)  ->  $newHdrName"
        }
        else {
            Write-Warning "No HDR found matching: $oldBase"
        }
    }
}

Write-Host "`nAll renaming complete."
