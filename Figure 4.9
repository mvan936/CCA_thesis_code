  mutate(
    Treatment = factor(
      Treatment,
      levels = c("EDTA", "UV", "FW", "Vinegar", "NaOCl", "Scrub", "Ctrl")
    )
  )

# ---- ADD: letters from Dunn post hoc (Holm-adjusted) ----
letters_df <- data.frame(
  Treatment = factor(
    c("EDTA", "UV", "FW", "Vinegar", "NaOCl", "Scrub", "Ctrl"),
