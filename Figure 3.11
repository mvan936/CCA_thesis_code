# ================================
# Experiment 2: Growth change plot + stats (no mean "X")
# Reads: Percentages_nutrients.xlsx (sheet: Percentages_nutrients)
# Output: Figure_change_green_noX.png + console stats tables
# ================================

# Packages
library(readxl)
library(tidyverse)
library(rstatix)

# Set working directory (edit if needed)
setwd("C:/Users/ADMIN/OneDrive/NT+UOA/CCA 24-25/Experiment 2")

# ----------------
# 1) Import data
# ----------------
dat <- read_excel(
  "Percentages_nutrients.xlsx",
  sheet = "Percentages_nutrients"
)

# -------------------------------
# 2) Clean + average duplicates
# -------------------------------
dat_clean <- dat %>%
  mutate(
    Side = if_else(Side %in% c("b", "B"), "B",
                   if_else(Side %in% c("a", "A"), "A", Side))
  ) %>%
  rename(green_adj = `% green adj`) %>%
  group_by(RhoID, Treatment, Side, Timepoint) %>%
  summarise(
    green_adj = mean(green_adj, na.rm = TRUE),
    .groups = "drop"
  )

# -----------------------------------------
# 3) Pivot wide and compute change (T8-T4)
# -----------------------------------------
change_dat <- dat_clean %>%
  pivot_wider(
    names_from  = Timepoint,
    values_from = green_adj
  ) %>%
  mutate(
    delta_green = T8 - T4
  )

# Keep only rows with a valid change score
change_dat2 <- change_dat %>%
  filter(!is.na(delta_green))

# -----------------------------------------
# 4) Treatment order + labels for plotting
# -----------------------------------------
treat_levels <- c("1","2","3","4","5","6","7","8")
treat_labels <- c(
  "Ctrl",
  "Ctrl+F2P",
  "25C",
  "25C+F2P",
  "60\u00B5",
  "60\u00B5+F2P",
  "7H",
  "7H+F2P"
)

change_dat2 <- change_dat2 %>%
  mutate(
    Treatment = factor(as.character(Treatment), levels = treat_levels),
    Treatment_label = factor(Treatment, labels = treat_labels)
  )

# -------------------------
# 5) Statistical analyses
# -------------------------
# Kruskal-Wallis
kw <- kruskal_test(change_dat2, delta_green ~ Treatment_label)
print(kw)

# Dunn post-hoc (BH adjusted)
dunn <- dunn_test(
  change_dat2,
  delta_green ~ Treatment_label,
  p.adjust.method = "BH"
)
print(dunn)

# Significant pairs only (optional)
sig_pairs <- dunn %>% filter(p.adj < 0.05)
print(sig_pairs)

# -------------------------
# 6) Plot (NO mean "X")
# -------------------------
p <- ggplot(change_dat2, aes(x = Treatment_label, y = delta_green)) +
  geom_boxplot(
    width = 0.6,
    outlier.shape = NA,
    colour = "black",
    fill = "white",
    linewidth = 0.6
  ) +
  geom_jitter(
    width = 0.12,
    size = 2,
    colour = "black",
    alpha = 0.8
  ) +
  labs(
    x = "Treatment",
    y = "Growth change (%)"
  ) +
  theme_classic(base_size = 12) +
  theme(
    axis.title = element_text(size = 12),
    axis.text = element_text(size = 11, colour = "black"),
    axis.line = element_line(colour = "black"),
    legend.position = "none"
  )

print(p)

# -------------------------
# 7) Save figure
# -------------------------
ggsave(
  filename = "Figure_change_green_noX.png",
  plot = p,
  width = 18,
  height = 12,
  units = "cm",
  dpi = 300
)

# Quick data completeness check (optional)
change_dat2 %>%
  summarise(
    n_total = n(),
    n_missing_delta = sum(is.na(delta_green))
  ) %>%
  print()
